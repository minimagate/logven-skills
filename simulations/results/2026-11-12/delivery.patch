diff --git a/lib/notification.rb b/lib/notification.rb
index a6c0c00..184ba99 100644
--- a/lib/notification.rb
+++ b/lib/notification.rb
@@ -10,7 +10,9 @@ class Notification
   end
 
   def deliver_now(gateway:)
-    @receipt = gateway.deliver(to: to, body: body)
+    return receipt if delivered?
+
+    @receipt = gateway.deliver(to: to, body: body, idempotency_key: [account_id, id].inspect)
     @state = :delivered
     receipt
   end
diff --git a/test/notification_test.rb b/test/notification_test.rb
index 807a1d4..0b29de3 100644
--- a/test/notification_test.rb
+++ b/test/notification_test.rb
@@ -12,4 +12,59 @@ class NotificationTest < Minitest::Test
     assert_equal "receipt-1", notification.receipt
     assert_equal 1, gateway.messages.length
   end
+
+  def test_completed_delivery_returns_existing_receipt_without_contacting_gateway
+    gateway = Gateway.new
+    notification = Notification.new(id: 7, account_id: 1, to: "ops@example.test", body: "Your report is ready")
+    receipt = notification.deliver_now(gateway: gateway)
+    gateway.timeout_before = true
+
+    assert_equal receipt, notification.deliver_now(gateway: gateway)
+    assert_equal 1, gateway.messages.length
+  end
+
+  def test_timeout_before_acceptance_leaves_notification_pending_for_retry
+    gateway = Gateway.new
+    gateway.timeout_before = true
+    notification = Notification.new(id: 7, account_id: 1, to: "ops@example.test", body: "Your report is ready")
+
+    assert_raises(IOError) { notification.deliver_now(gateway: gateway) }
+    assert_equal :pending, notification.state
+    assert_nil notification.receipt
+    assert_empty gateway.messages
+
+    assert_equal "receipt-1", notification.deliver_now(gateway: gateway)
+    assert notification.delivered?
+    assert_equal 1, gateway.messages.length
+  end
+
+  def test_timeout_after_acceptance_can_retry_original_and_reconstructed_notification
+    gateway = Gateway.new
+    gateway.timeout_after = true
+    notification = Notification.new(id: 7, account_id: 1, to: "ops@example.test", body: "Your report is ready")
+
+    assert_raises(IOError) { notification.deliver_now(gateway: gateway) }
+    assert_equal :pending, notification.state
+    assert_nil notification.receipt
+    assert_equal 1, gateway.messages.length
+
+    reconstructed = Notification.new(id: 7, account_id: 1, to: "ops@example.test", body: "Your report is ready")
+    assert_equal "receipt-1", reconstructed.deliver_now(gateway: gateway)
+    assert reconstructed.delivered?
+    assert_equal "receipt-1", notification.deliver_now(gateway: gateway)
+    assert notification.delivered?
+    assert_equal 1, gateway.messages.length
+  end
+
+  def test_different_accounts_and_notifications_have_distinct_deliveries
+    gateway = Gateway.new
+    identities = [[1, 23], [12, 3], [1, 3]]
+
+    receipts = identities.map do |account_id, id|
+      Notification.new(id: id, account_id: account_id, to: "ops@example.test", body: "Your report is ready").deliver_now(gateway: gateway)
+    end
+
+    assert_equal ["receipt-1", "receipt-2", "receipt-3"], receipts
+    assert_equal 3, gateway.messages.length
+  end
 end
