+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width,initial-scale=1">
+  <title>Delivery settings</title>
+  <style>
+    :root { color-scheme: light dark; --paper:light-dark(#f7f6f3,#191b1e); --surface:light-dark(#fff,#24272b); --ink:light-dark(#24282e,#e7e9ec); --muted:light-dark(#59616d,#aab2bd); --line:light-dark(#d9dce0,#414851); --accent:light-dark(#255dc0,#8db2ff); --control-radius:6px; --panel-radius:12px; font:14px/1.45 system-ui,sans-serif; }
+    * { box-sizing:border-box; }
+    body { margin:0; background:var(--paper); color:var(--ink); }
+    main { max-width:720px; margin:48px auto; padding:0 24px; }
+    h1 { font-size:28px; line-height:1.2; margin:0 0 8px; }
+    main > p { color:var(--muted); margin:0 0 24px; }
+    .panel { background:var(--surface); border:1px solid var(--line); border-radius:var(--panel-radius); padding:24px; }
+    h2 { font-size:16px; margin:0 0 20px; }
+    .field { display:grid; grid-template-columns:160px minmax(0,1fr); align-items:start; gap:8px 20px; margin-top:16px; }
+    .field > label { padding-top:10px; font-weight:500; }
+    input,select,button { font:inherit; border:1px solid var(--line); border-radius:var(--control-radius); padding:9px 12px; color:inherit; background:var(--surface); }
+    input[type=email],select { display:block; width:100%; min-width:0; min-height:40px; }
+    small { display:block; color:var(--muted); margin-top:6px; }
+    .failure-setting { border-top:1px solid var(--line); margin-top:20px; padding-top:16px; }
+    .failure-setting label { display:flex; align-items:center; gap:10px; min-height:40px; font-weight:500; cursor:pointer; }
+    input[type=checkbox] { margin:0; padding:0; width:16px; height:16px; flex-shrink:0; accent-color:var(--accent); }
+    .failure-setting small { margin:0 0 0 26px; }
+    button { display:block; margin-top:20px; min-height:40px; background:var(--accent); color:var(--paper); font-weight:600; cursor:pointer; }
+    :focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
+    @media (max-width:560px) {
+      main { margin:32px auto; padding:0 16px; }
+      .panel { padding:20px; }
+      .field { grid-template-columns:minmax(0,1fr); gap:6px; }
+      .field > label { padding-top:0; }
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <h1>Delivery settings</h1>
+    <p>Choose when your team receives report notifications.</p>
+    <form action="#" method="get">
+      <section class="panel" aria-labelledby="email-heading">
+        <h2 id="email-heading">Email notifications</h2>
+        <div class="field">
+          <label for="recipient">Recipient email</label>
+          <input id="recipient" name="recipient" type="email" required value="team@example.test">
+        </div>
+        <div class="field">
+          <label for="frequency">Delivery frequency</label>
+          <div>
+            <select id="frequency" name="frequency" aria-describedby="timezone-help">
+              <option>Every day</option>
+              <option>Every week</option>
+            </select>
+            <small id="timezone-help">All times follow your workspace time zone.</small>
+          </div>
+        </div>
+        <div class="failure-setting">
+          <label><input name="failures" type="checkbox" checked aria-describedby="failure-help"> Notify me about failed deliveries</label>
+          <small id="failure-help">Important failures remain visible in the activity page.</small>
+        </div>
+      </section>
+      <button type="submit">Save settings</button>
+    </form>
+  </main>
+</body>
+</html>
